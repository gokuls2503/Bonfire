# Copy to /srv/bonfire/backend/.env and fill in. chmod 600.

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.bonfiregaminghub.com
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO

POSTGRES_DB=bonfire
POSTGRES_USER=bonfire
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Browsers calling the API must be listed here or CORS blocks them.
CORS_ALLOWED_ORIGINS=https://bonfiregaminghub.com,https://www.bonfiregaminghub.com,https://admin.bonfiregaminghub.com
CSRF_TRUSTED_ORIGINS=https://bonfiregaminghub.com,https://www.bonfiregaminghub.com,https://admin.bonfiregaminghub.com,https://api.bonfiregaminghub.com

SECURE_SSL_REDIRECT=True
